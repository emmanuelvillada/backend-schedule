generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                    @id @default(uuid())
  email                   String                    @unique
  password                String
  name                    String
  phone                   String?
  avatarUrl               String?
  avatarPath              String?
  role                    Role                      @default(CLIENT)
  emailVerified           Boolean                   @default(false)
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  clientAppointments      Appointment[]             @relation("ClientAppointments")
  ownedBusiness           Business?                 @relation("OwnerBusinesses")
  employeeProfile         Employee?
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  reviews                 Review[]                  @relation("ClientReviews")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Business {
  id           String           @id @default(uuid())
  name         String
  description  String?
  category     BusinessCategory
  ownerId      String           @unique
  address      String?
  phone        String?
  latitude     Float?
  longitude    Float?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  appointments Appointment[]
  owner        User             @relation("OwnerBusinesses", fields: [ownerId], references: [id])
  employees    Employee[]
  schedules    Schedule[]
  services     Service[]
  reviews      Review[]
  images       BusinessImage[]
  closures     BusinessClosure[]
}

// Días puntuales (no recurrentes) donde el negocio no atiende: festivos,
// vacaciones, etc. Distinto de `Schedule`, que es el horario semanal fijo.
model BusinessClosure {
  id         String   @id @default(uuid())
  businessId String
  date       String // "YYYY-MM-DD"
  reason     String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId])
}

model BusinessImage {
  id         String   @id @default(uuid())
  businessId String
  url        String
  path       String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Service {
  id           String               @id @default(uuid())
  name         String
  description  String?
  durationMin  Int
  price        Float
  isActive     Boolean              @default(true)
  businessId   String
  appointments AppointmentService[]
  business     Business             @relation(fields: [businessId], references: [id])
  employees    Employee[]           @relation("EmployeeToService")
}

model Schedule {
  id         String   @id @default(uuid())
  businessId String
  dayOfWeek  Int
  openTime   String
  closeTime  String
  business   Business @relation(fields: [businessId], references: [id])
}

model Employee {
  id           String             @id @default(uuid())
  userId       String             @unique
  businessId   String
  appointments Appointment[]
  business     Business           @relation(fields: [businessId], references: [id])
  user         User               @relation(fields: [userId], references: [id])
  schedules    EmployeeSchedule[]
  services     Service[]          @relation("EmployeeToService")
}

model EmployeeSchedule {
  id         String   @id @default(uuid())
  employeeId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model Appointment {
  id         String               @id @default(uuid())
  startTime  DateTime
  endTime    DateTime
  status     AppointmentStatus    @default(PENDING)
  notes      String?
  businessId String
  clientId   String
  employeeId String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  notificationSent Boolean  @default(false)
  business   Business             @relation(fields: [businessId], references: [id])
  client     User                 @relation("ClientAppointments", fields: [clientId], references: [id])
  employee   Employee?            @relation(fields: [employeeId], references: [id])
  services   AppointmentService[]
  review     Review?
  payment    Payment?
}

model Payment {
  id             String        @id @default(uuid())
  appointmentId  String        @unique
  appointment    Appointment   @relation(fields: [appointmentId], references: [id])
  status         PaymentStatus @default(PENDING)
  amount         Float
  currency       String        @default("COP")
  preferenceId   String? // id de la preferencia de MercadoPago (Checkout Pro)
  mpPaymentId    String? // id del pago en MercadoPago, se conoce tras el webhook
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([mpPaymentId])
}

model Review {
  id             String      @id @default(uuid())
  rating         Int
  comment        String?
  createdAt      DateTime    @default(now())
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id])
  clientId       String
  client         User        @relation("ClientReviews", fields: [clientId], references: [id])
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  ownerReply     String?
  ownerRepliedAt DateTime?

  @@index([businessId])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  priceAtTime   Float
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  CLIENT
  BUSINESS_OWNER
  EMPLOYEE
  ADMIN
}

enum BusinessCategory {
  BARBERIA
  SPA
  MECANICA
  BELLEZA
  OTRO
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}
