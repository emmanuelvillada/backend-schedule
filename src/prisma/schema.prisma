generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DIRECT_URL") 
}

enum Role {
  CLIENT
  BUSINESS_OWNER
  EMPLOYEE
  ADMIN
}

enum BusinessCategory {
  BARBERIA
  SPA
  MECANICA
  BELLEZA
  OTRO
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())

  ownedBusinesses    Business[]    @relation("OwnerBusinesses")
  clientAppointments Appointment[] @relation("ClientAppointments")
  employeeProfile    Employee?
}

model Business {
  id          String           @id @default(uuid())
  name        String
  description String?
  category    BusinessCategory
  ownerId     String
  owner       User             @relation("OwnerBusinesses", fields: [ownerId], references: [id])

  services     Service[]
  employees    Employee[]
  schedules    Schedule[]
  appointments Appointment[]

  createdAt DateTime @default(now())
}

model Service {
  id          String  @id @default(uuid())
  name        String
  durationMin Int
  price       Float
  isActive    Boolean @default(true) // Útil para "eliminar" servicios sin romper historial

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  employees    Employee[]
  appointments AppointmentService[]
}

model Schedule {
  id         String @id @default(uuid())
  businessId String
  dayOfWeek  Int // 0-6
  openTime   String // HH:mm
  closeTime  String // HH:mm

  business Business @relation(fields: [businessId], references: [id])
}

model Employee {
  id         String @id @default(uuid())
  userId     String @unique
  businessId String

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  services     Service[]
  schedules    EmployeeSchedule[]
  appointments Appointment[]
}

model EmployeeSchedule {
  id         String @id @default(uuid())
  employeeId String
  dayOfWeek  Int
  startTime  String
  endTime    String

  employee Employee @relation(fields: [employeeId], references: [id])
}

model Appointment {
  id        String            @id @default(uuid())
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String?

  businessId String
  clientId   String
  employeeId String?

  business Business  @relation(fields: [businessId], references: [id])
  client   User      @relation("ClientAppointments", fields: [clientId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  services AppointmentService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppointmentService {
  appointmentId String
  serviceId     String
  priceAtTime   Float // Para auditoría de precios históricos

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}
