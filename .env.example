# Database (Supabase)
# Pooler URL — used by the app at runtime (port 6543, pgbouncer Transaction mode)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct URL — used by Prisma CLI for migrations (port 5432, may be blocked by some ISPs)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=1d

# Server
PORT=3000
NODE_ENV=production

# CORS — set to your frontend's production URL
CORS_ORIGIN=https://your-frontend-domain.com
